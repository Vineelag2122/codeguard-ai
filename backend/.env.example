# Copy to backend/.env and fill in ONE provider key to enable the AI layer.
# Without a key CodeGuard still runs all rule/AST/Bandit checks.

# Groq (free tier, fast): https://console.groq.com/keys
GROQ_API_KEY=

# or OpenAI
# OPENAI_API_KEY=

# Optional overrides
# CODEGUARD_LLM_PROVIDER=groq            # groq | openai
# CODEGUARD_LLM_MODEL=openai/gpt-oss-120b   # auto-falls back if the model is retired
# CODEGUARD_LLM_BASE_URL=http://localhost:11434/v1   # any OpenAI-compatible server (Ollama, LM Studio...)
# CODEGUARD_LLM_API_KEY=                  # key for a custom base URL
# CODEGUARD_SEMGREP=0                     # disable semgrep even if installed
# CODEGUARD_MAX_UPLOAD_MB=50
